{
    "summary": "Defines the shared V3 identity, type, version and resource limits so PHP and CodeMirror cannot disagree; depends on the approved V3 editor specification and current Markdown limits.",
    "contentFormatVersion": 3,
    "fileVersion": 3,
    "dialect": "orbium-markdown-v3",
    "feature": { "name": "stable_blocks", "version": 1 },
    "spacerFeature": { "name": "spacers", "version": 1 },
    "idPattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
    "limits": {
        "sourceBytes": 2097152,
        "lineBytes": 131072,
        "lines": 100000,
        "blocks": 100000,
        "depth": 32,
        "diagnostics": 100
    },
    "blockTypes": {
        "paragraph": "text",
        "spacer": "spacing",
        "heading-1": "text",
        "heading-2": "text",
        "heading-3": "text",
        "heading-4": "text",
        "heading-5": "text",
        "heading-6": "text",
        "bullet-list": "text",
        "numbered-list": "text",
        "checklist": "text",
        "quote": "text",
        "callout": "rich",
        "divider": "rich",
        "code": "rich",
        "mermaid": "rich",
        "math": "rich",
        "table": "rich",
        "image": "rich",
        "file": "rich",
        "video": "rich",
        "audio": "rich",
        "pdf": "rich",
        "mindmap": "rich",
        "columns": "container"
    }
}
